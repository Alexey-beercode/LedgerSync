# Copy to .env and adjust. .env is git-ignored: never commit real secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
API_PORT=8080

# File (mock CSV) or AppsScript (real Google Sheet)
GOOGLE_SHEETS_MODE=File
# Required only for AppsScript mode. This URL is a secret.
GOOGLE_SHEETS_APPS_SCRIPT_URL=
