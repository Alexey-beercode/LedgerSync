{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LedgerSync": ""
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "ExternalApi": {
    "BaseUrl": "",
    "DocumentsPath": "/mock/external/documents",
    "MaxRetryAttempts": 3
  },
  "GoogleSheets": {
    "FilePath": "google-sheets-mock/sync-log.csv"
  },
  "MockExternalApi": {
    "Enabled": false
  }
}
